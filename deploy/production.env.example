# Reference only: configure .env manually on the production server. No real secrets.
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-new-random-secret-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=sitarogroup.ir,www.sitarogroup.ir
DJANGO_CSRF_TRUSTED_ORIGINS=https://sitarogroup.ir,https://www.sitarogroup.ir
POSTGRES_DB=sitaro
POSTGRES_USER=sitaro
POSTGRES_PASSWORD=replace-with-a-unique-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-username
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@sitarogroup.ir
# Real fullchain.pem and privkey.pem; NOT symlinks outside this mount.
TLS_CERTIFICATE_DIR=/etc/sitaro/tls
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=180
DJANGO_SECURE_HSTS_SECONDS=3600
